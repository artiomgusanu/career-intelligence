POSTGRES_PASSWORD=replace_with_a_local_password

# Use 127.0.0.1 rather than localhost: on Windows, localhost can resolve to IPv6 (::1)
# first, which the Docker port binding (IPv4 only) does not answer, causing connections to hang.
DATABASE_URL=postgresql+psycopg://app:replace_with_a_local_password@127.0.0.1:5432/career_intelligence

# Dedicated database for PostgreSQL integration tests. Must end in "_test" and differ
# from DATABASE_URL. Tests truncate its tables. Create it once with: pytest --create-test-db
TEST_DATABASE_URL=postgresql+psycopg://app:replace_with_a_local_password@127.0.0.1:5432/career_intelligence_test

# Logging and outbound HTTP for ingestion (optional; defaults shown).
# LOG_LEVEL=INFO
# HTTP_TIMEOUT_SECONDS=10
# HTTP_MAX_RETRIES=2
# HTTP_BACKOFF_SECONDS=0.5
# Longest Retry-After (429/503) honoured, 0-3600; a longer requested wait fails the request.
# HTTP_MAX_RETRY_AFTER_SECONDS=60

# ITJobs.pt API key, required only by the `itjobs` ingestion source. Read from the
# environment or .env, never from command-line arguments; redacted from logs and errors.
# Leave it empty here: a blank value is treated as unset (the command exits with code 2
# before any request). Never commit a real key. Real API use remains pending explicit
# authorization.
ITJOBS_API_KEY=
